# --- Server ---
PORT=4000
HOST_PORT=4000
PUBLIC_URL=https://your-domain.com
BUBAI_INSTANCE_NAME=Bubai

# --- PostgreSQL (supports PG 17/18 Direct TLS via sslnegotiation=direct; omit to use local PGlite) ---
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/beta-bubai?sslmode=require&sslnegotiation=direct"

# --- S3-Compatible Upload Storage (AWS S3 / Cloudflare R2 / MinIO / RustFS / Aliyun OSS / TOS) ---
# When S3_BUCKET + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY are set, all /api/uploads go to S3.
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=bubai-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional prefix inside the bucket (default: uploads)
S3_PREFIX=uploads
# Optional public CDN/bucket base URL. If omitted, files are served via /api/uploads/:filename (works for private buckets).
S3_PUBLIC_URL=

# --- Botmux Bridge ---
# Use http://host.docker.internal:7891 when Botmux runs on the Docker host
BOTMUX_ENDPOINT=http://host.docker.internal:7891
BOTMUX_TOKEN=
BOTMUX_PROXY_TERMINAL=true

# --- Bot Outbound API & Reply Policy ---
BUZZ_BOT_TOKEN=
BUZZ_REPLY_MODE=follow_source
BUZZ_CONTEXT_LIMIT=20
