{
  "name": "buzz-botmux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "bun test packages/botmux-client/src packages/chat-client/src apps/server/src",
    "test:e2e": "bun test --timeout 30000 ./tests/e2e",
    "buzz:send": "node scripts/buzz-send.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
