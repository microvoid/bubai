{
  "name": "@bubx/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Embeddable BubAI agent runtime",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "module": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./process": {
      "types": "./src/local-process.ts",
      "bun": "./src/local-process.ts",
      "module": "./src/local-process.ts",
      "default": "./dist/local-process.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "bun": "./src/config.ts",
      "module": "./src/config.ts",
      "default": "./dist/config.js"
    },
    "./profiles": {
      "types": "./src/profiles.ts",
      "bun": "./src/profiles.ts",
      "module": "./src/profiles.ts",
      "default": "./dist/profiles.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test src"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@opentelemetry/api": "1.9.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/bun": "^1.2.15"
  }
}
